DATABASE_URL=sqlite:///./shopify_analytics_engine.db
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
SESSION_COOKIE_DOMAIN=
MAGIC_LINK_FROM_EMAIL=skubase <info@skubase.io>
MAGIC_LINK_REPLY_TO=info@skubase.io
RESEND_API_KEY=
BACKEND_PUBLIC_URL=http://localhost:8000
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_HANDLE=
SHOPIFY_BILLING_TEST=false
SQLALCHEMY_ECHO=false
CONTACT_TO_EMAIL=info@skubase.io
WAITLIST_FROM_EMAIL=skubase <info@skubase.io>
WAITLIST_REPLY_TO=info@skubase.io

# Persistent worker runs inside the existing API process; no paid scheduler required.
GROWTH_ENABLED=false
GROWTH_DISCOVERY_ENABLED=true
GROWTH_MAILBOX=info@skubase.io
GROWTH_RESEND_API_KEY=
GROWTH_RESEND_WEBHOOK_SECRET=
GROWTH_INBOUND_ENABLED=false
GROWTH_EMAIL_ENABLED=false
# Requested-service responses only. No postal address required by this runtime.
# Legacy setting; first-contact admission is a fixed 20 per rolling 24h.
# Requested service replies do not consume this allowance.
GROWTH_DAILY_EMAILS=20
# Explicit owner-approved model/API ceiling. Advertising has no execution adapter.
GROWTH_DAILY_USD=0
GROWTH_EMAIL_UNIT_USD=0
GROWTH_MODEL_ENABLED=false
OPENAI_API_KEY=
# Ask Skubase is independent from growth-agent model permissions. Disabled until
# the owner configures an API key and explicitly approves its separate USD cap.
AI_CHAT_ENABLED=false
AI_CHAT_MODEL=gpt-5.6-luna
AI_CHAT_DAILY_USD=0
AI_CHAT_SHOP_DAILY_USD=0.05
AI_CHAT_SHOP_DAILY_REQUESTS=30
AI_CHAT_SHOP_PER_MINUTE=3
GROWTH_REVIEW_MODE=codex
# Optional read-only Shopify Partner receipts. Never infer payment from a trial.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_API_TOKEN=
GROWTH_EXCLUDED_SHOP_DOMAINS=skubase-test.myshopify.com
